# Copy to .env and fill in.

# LLM provider
OPENROUTER_API_KEY=

# Agent Models
PROPOSER_AGENT_MODEL=openrouter:openai/gpt-6-luna
CRITIC_AGENT_MODEL=openrouter:anthropic/claude-haiku-5.5
SUMMARIZER_AGENT_MODEL=openrouter:google/gemini-3.5-flash-lite

# # Optional Limits (defaults shown)
# DE_MAX_ROUNDS=12
# DE_STALL_ROUNDS=3
# DE_MAX_TOKENS=8000

# # Optional Inputs: System Description and Feature Request
# DE_SYSTEM_DESCRIPTION="CRM system."
# DE_FEATURE_REQUEST="Add event driven notifications."